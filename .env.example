# ==============================================================================
# Recoverix - Environment Configuration Example
# Copy this file to .env before starting containers:
#   cp .env.example .env
# ==============================================================================

# Backend: Offline mode enforcement (1 = deterministic rules only, no external calls)
RECOVERIX_OFFLINE=1

# Backend: Allowed CORS origins (comma-separated list or JSON array of browser origins).
# Defaults to local loopback origins:
#   http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
#
# Configuration Rules:
# - Valid entries must match scheme://host[:port] with no path or query (e.g. http://localhost:3000).
# - Wildcards ("*") are strictly rejected to prevent cross-origin data exfiltration.
# - Setting RECOVERIX_CORS_ORIGINS=none (or disabled) disables all cross-origin requests.
# - Malformed entries are filtered out; if all entries are invalid, it safely falls back to loopback defaults.
#
# Security Note:
# - CORS is a browser-enforced policy, NOT backend authentication.
# - Recoverix does NOT have built-in authentication or access control.
# - Wildcard origins must never be permitted on networked or multi-user deployments.
# RECOVERIX_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend: Backend API URL accessible from the investigator's web browser
NEXT_PUBLIC_API_URL=http://localhost:8000
